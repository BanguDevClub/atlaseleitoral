---
import '@/styles/global.css';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { url } from '@/lib/base';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article' | 'profile';
  keywords?: string;
  canonical?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title,
  description = 'Atlas Eleitoral 2026 — dashboard e observatório independente das eleições presidenciais do Brasil. Compasso político em 2 eixos, propostas por tema, pesquisas consolidadas e fontes primárias verificadas.',
  image,
  imageAlt = 'Atlas Eleitoral 2026 — O mapa das eleições presidenciais do Brasil',
  ogType = 'website',
  keywords = 'eleições 2026, candidatos presidência brasil 2026, compasso político brasil, pesquisas eleitorais 2026, tse candidatos, lula, flavio bolsonaro, zema, ronaldo caiado, propostas candidatos brasil',
  canonical,
  jsonLd,
} = Astro.props;

const siteOrigin = Astro.site ? Astro.site.origin : 'https://bangudevclub.github.io';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteOrigin).href;

// Ensure absolute image URL for Open Graph and Twitter
const rawImagePath = image ? (image.startsWith('/') ? url(image) : image) : url('/og-image.jpg');
const ogImageUrl = rawImagePath.startsWith('http') ? rawImagePath : new URL(rawImagePath, siteOrigin).href;

const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}${url('/')}#website`,
      url: `${siteOrigin}${url('/')}`,
      name: 'Atlas Eleitoral 2026',
      description: 'Dashboard das eleições presidenciais do Brasil de 2026 com compasso político, propostas e fontes verificadas.',
      inLanguage: 'pt-BR',
      publisher: {
        '@type': 'Organization',
        name: 'BanguDevClub',
        url: 'https://github.com/BanguDevClub',
        logo: {
          '@type': 'ImageObject',
          url: `${siteOrigin}${url('/icon-512.png')}`,
        },
      },
    },
    ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
  ],
};
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="BanguDevClub" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:site_name" content="Atlas Eleitoral 2026" />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="twitter:creator" content="@BanguDevClub" />
    <meta name="twitter:site" content="@BanguDevClub" />

    <!-- Favicon & Touch Icons -->
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={url('/favicon-16x16.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={url('/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/site.webmanifest')} />

    <!-- Mobile Web App & Theme Color -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Atlas Eleitoral" />
    <meta name="application-name" content="Atlas Eleitoral" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="theme-color" content="#090d16" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(defaultJsonLd)} />

    <!-- Prevent FOUC and initialize theme immediately -->
    <script is:inline>
      (function () {
        var theme = null;
        try {
          theme = localStorage.getItem('atlas-flavor');
        } catch (e) {}
        var validThemes = ['light', 'dark', 'latte', 'frappe', 'macchiato', 'mocha'];
        if (!theme || validThemes.indexOf(theme) === -1) {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        var root = document.documentElement;
        root.setAttribute('data-theme', theme);
        var isDark = theme !== 'light' && theme !== 'latte';
        if (isDark) {
          root.classList.add('dark');
        } else {
          root.classList.remove('dark');
        }

        // Listen for OS scheme changes if not explicitly overridden
        try {
          window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
            if (!localStorage.getItem('atlas-flavor')) {
              var newTheme = e.matches ? 'dark' : 'light';
              root.setAttribute('data-theme', newTheme);
              root.classList.toggle('dark', e.matches);
            }
          });
        } catch (err) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased selection:bg-ctp-mauve/25 selection:text-foreground">
    <SiteHeader />
    <slot />
    <SiteFooter />
  </body>
</html>
