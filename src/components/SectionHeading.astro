---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  class?: string;
}

const { eyebrow, title, description, class: className = '' } = Astro.props;
---

<div class={`flex flex-col gap-2 ${className}`}>
  {
    eyebrow && (
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-border/70 bg-card/60 px-2.5 py-0.5 text-[11px] font-semibold tracking-wider text-ctp-mauve uppercase backdrop-blur-xs">
          <span class="size-1.5 rounded-full bg-ctp-mauve"></span>
          {eyebrow}
        </span>
      </div>
    )
  }
  <h2 class="font-heading text-2xl font-bold tracking-tight text-foreground sm:text-3xl text-balance">
    {title}
  </h2>
  {
    description && (
      <p class="max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">
        {description}
      </p>
    )
  }
</div>
