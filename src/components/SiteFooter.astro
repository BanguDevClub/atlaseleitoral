---
import { url, REPO_URL } from '@/lib/base';

const year = new Date().getFullYear();

const navLinks = [
  { href: url('/'), label: 'Início' },
  { href: url('/candidatos'), label: 'Candidatos' },
  { href: url('/compasso'), label: 'Compasso Político' },
  { href: url('/comparar'), label: 'Comparar Candidatos' },
  { href: url('/pesquisas'), label: 'Pesquisas Eleitorais' },
  { href: url('/metodologia'), label: 'Metodologia Editorial' },
];

const externalLinks = [
  { href: 'https://divulgacandcontas.tse.jus.br/', label: 'TSE — DivulgaCandContas' },
  { href: 'https://www.tse.jus.br/', label: 'Tribunal Superior Eleitoral' },
  { href: REPO_URL, label: 'Repositório no GitHub' },
];
---

<footer class="mt-20 border-t border-border/60 bg-card/30 transition-colors pb-[calc(1.5rem+env(safe-area-inset-bottom,0px))]">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Col 1: Brand & Mission -->
      <div class="space-y-4 lg:col-span-2">
        <div class="flex items-center gap-2.5">
          <div class="flex size-8 items-center justify-center rounded-xl bg-gradient-to-tr from-ctp-mauve/25 via-ctp-blue/20 to-ctp-teal/20 p-1.5 ring-1 ring-border shadow-xs">
            <svg viewBox="0 0 32 32" class="size-5" aria-hidden="true">
              <circle cx="16" cy="16" r="14" fill="none" stroke="currentColor" stroke-width="1.2" stroke-opacity="0.25" stroke-dasharray="2 2" />
              <polygon points="16,3 18,14 16,16" fill="var(--ctp-mauve)" />
              <polygon points="16,3 14,14 16,16" fill="var(--ctp-pink)" opacity="0.8" />
              <polygon points="16,29 18,18 16,16" fill="var(--ctp-blue)" />
              <polygon points="16,29 14,18 16,16" fill="var(--ctp-sky)" opacity="0.8" />
              <polygon points="29,16 18,18 16,16" fill="var(--ctp-teal)" />
              <polygon points="29,16 18,14 16,16" fill="var(--ctp-green)" opacity="0.8" />
              <polygon points="3,16 14,18 16,16" fill="var(--ctp-peach)" />
              <polygon points="3,16 14,14 16,16" fill="var(--ctp-yellow)" opacity="0.8" />
              <circle cx="16" cy="16" r="3" fill="var(--card)" stroke="var(--ctp-yellow)" stroke-width="1.2" />
              <circle cx="16" cy="16" r="1.5" fill="var(--ctp-green)" />
            </svg>
          </div>
          <span class="font-heading text-lg font-bold tracking-tight text-foreground">Atlas Eleitoral</span>
          <span class="inline-flex items-center gap-1 rounded-full border border-border/70 bg-muted/60 px-2 py-0.5 text-[10px] font-mono font-medium text-muted-foreground">
            2026
          </span>
        </div>
        <p class="max-w-md text-sm leading-relaxed text-muted-foreground">
          Plataforma cívica e educacional com foco nas eleições presidenciais brasileiras de 2026.
          Todas as posições e afirmações contam com links para as fontes originais primárias e veículos jornalísticos verificados.
        </p>
        <div class="flex items-center gap-2 text-xs text-muted-foreground">
          <span class="inline-flex size-2 rounded-full bg-ctp-green animate-pulse"></span>
          <span>Projeto independente sem filiação partidária</span>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div class="space-y-3">
        <p class="text-xs font-semibold tracking-wider text-foreground uppercase">Navegação</p>
        <ul class="space-y-2 text-sm text-muted-foreground">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} class="transition-colors hover:text-foreground hover:underline underline-offset-4">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 3: Sources & Data -->
      <div class="space-y-3">
        <p class="text-xs font-semibold tracking-wider text-foreground uppercase">Fontes Oficiais & Código</p>
        <ul class="space-y-2 text-sm text-muted-foreground">
          {
            externalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 transition-colors hover:text-foreground hover:underline underline-offset-4"
                >
                  <span>{link.label}</span>
                  <svg viewBox="0 0 24 24" class="size-3 opacity-70" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-border/60 pt-6 text-xs text-muted-foreground sm:flex-row">
      <p>© {year} Atlas Eleitoral · BanguDevClub. Dados públicos abertos sob licença educacional.</p>
      
      <button
        type="button"
        id="back-to-top-btn"
        class="inline-flex items-center gap-1.5 rounded-lg border border-border/70 bg-card px-3 py-1.5 text-xs font-medium text-foreground transition-all duration-200 hover:border-ctp-mauve/50 hover:bg-muted/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <span>Voltar ao topo</span>
        <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
      </button>
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    const btn = document.getElementById('back-to-top-btn');
    if (!btn) return;
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  })();
</script>
