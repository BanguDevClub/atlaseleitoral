---
import ThemeSwitcher from '@/components/ThemeSwitcher';

const links = [
  { href: '/', label: 'Início' },
  { href: '/candidatos', label: 'Candidatos' },
  { href: '/compasso', label: 'Compasso' },
  { href: '/comparar', label: 'Comparar' },
  { href: '/pesquisas', label: 'Pesquisas' },
  { href: '/metodologia', label: 'Metodologia' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-40 border-b border-border/60 bg-background/85 backdrop-blur-md">
  <div class="mx-auto flex h-14 max-w-7xl items-center gap-3 px-4 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2" aria-label="Atlas Eleitoral — início">
      <svg viewBox="0 0 24 24" class="size-7" aria-hidden>
        <circle cx="12" cy="12" r="10" fill="none" stroke="var(--ctp-mauve)" stroke-width="1.6"></circle>
        <path d="M12 3.2 14 10.2 20.8 12 14 13.8 12 20.8 10 13.8 3.2 12 10 10.2Z" fill="var(--ctp-mauve)"></path>
        <circle cx="12" cy="12" r="1.7" fill="var(--ctp-base)"></circle>
      </svg>
      <span class="font-heading text-lg font-semibold tracking-tight">Atlas Eleitoral</span>
    </a>

    <nav class="min-w-0 flex-1 overflow-x-auto" aria-label="Navegação principal">
      <ul class="flex items-center gap-1">
        {
          links.map((link) => {
            const active = path === link.href.replace(/\/$/, '') || (link.href !== '/' && path.startsWith(link.href));
            return (
              <li>
                <a
                  href={link.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'inline-flex h-8 items-center rounded-md px-2.5 text-sm whitespace-nowrap transition-colors',
                    active
                      ? 'bg-muted font-medium text-foreground'
                      : 'text-muted-foreground hover:bg-muted/60 hover:text-foreground',
                  ]}
                >
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="shrink-0">
      <ThemeSwitcher client:load />
    </div>
  </div>
</header>
