---
import ThemeSwitcher from '@/components/ThemeSwitcher';
import { url, REPO_URL } from '@/lib/base';

const links = [
  { href: url('/'), label: 'Início', raw: '/' },
  { href: url('/candidatos'), label: 'Candidatos', raw: '/candidatos' },
  { href: url('/compasso'), label: 'Compasso', raw: '/compasso' },
  { href: url('/comparar'), label: 'Comparar', raw: '/comparar' },
  { href: url('/pesquisas'), label: 'Pesquisas', raw: '/pesquisas' },
  { href: url('/metodologia'), label: 'Metodologia', raw: '/metodologia' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const homePath = url('/').replace(/\/$/, '');
---

<header class="sticky top-0 z-50 border-b border-border/60 bg-background/85 backdrop-blur-xl transition-colors">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
    <!-- Brand Logo -->
    <a
      href={url('/')}
      class="group flex shrink-0 items-center gap-2.5 transition-transform duration-200 active:scale-95"
      aria-label="Atlas Eleitoral 2026 — Página inicial"
    >
      <div class="relative flex size-9 items-center justify-center rounded-xl bg-gradient-to-tr from-ctp-mauve/25 via-ctp-blue/20 to-ctp-teal/20 p-1.5 ring-1 ring-border group-hover:ring-ctp-mauve/60 transition-all duration-300 group-hover:shadow-md group-hover:shadow-ctp-mauve/20">
        <!-- SVG Vector Compass Logo -->
        <svg viewBox="0 0 32 32" class="size-6 transition-transform duration-700 ease-out group-hover:rotate-90" aria-hidden="true">
          <circle cx="16" cy="16" r="14" fill="none" stroke="currentColor" stroke-width="1.2" stroke-opacity="0.25" stroke-dasharray="2 2" />
          <circle cx="16" cy="16" r="11" fill="none" stroke="var(--ctp-mauve)" stroke-width="1.4" stroke-opacity="0.5" />
          <!-- Star Facets -->
          <polygon points="16,3 18,14 16,16" fill="var(--ctp-mauve)" />
          <polygon points="16,3 14,14 16,16" fill="var(--ctp-pink)" opacity="0.8" />
          <polygon points="16,29 18,18 16,16" fill="var(--ctp-blue)" />
          <polygon points="16,29 14,18 16,16" fill="var(--ctp-sky)" opacity="0.8" />
          <polygon points="29,16 18,18 16,16" fill="var(--ctp-teal)" />
          <polygon points="29,16 18,14 16,16" fill="var(--ctp-green)" opacity="0.8" />
          <polygon points="3,16 14,18 16,16" fill="var(--ctp-peach)" />
          <polygon points="3,16 14,14 16,16" fill="var(--ctp-yellow)" opacity="0.8" />
          <!-- Center Bezel -->
          <circle cx="16" cy="16" r="3.2" fill="var(--card)" stroke="var(--ctp-yellow)" stroke-width="1.2" />
          <circle cx="16" cy="16" r="1.5" fill="var(--ctp-green)" />
        </svg>
      </div>
      <div class="flex items-center gap-2">
        <span class="font-heading text-lg font-bold tracking-tight text-foreground">Atlas Eleitoral</span>
        <span class="inline-flex items-center gap-1 rounded-full border border-border/70 bg-muted/60 px-2 py-0.5 text-[10px] font-mono font-medium text-muted-foreground">
          <span class="size-1.5 rounded-full bg-ctp-green animate-pulse"></span>2026
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Navegação principal">
      {
        links.map((link) => {
          const cleanLink = link.href.replace(/\/$/, '');
          const active =
            link.raw === '/'
              ? currentPath === homePath || currentPath === `${homePath}/` || currentPath === '/'
              : currentPath.startsWith(cleanLink);
          return (
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'relative inline-flex h-9 items-center rounded-lg px-3 text-sm font-medium transition-all duration-200',
                active
                  ? 'bg-muted text-foreground shadow-xs font-semibold'
                  : 'text-muted-foreground hover:bg-muted/60 hover:text-foreground',
              ]}
            >
              {link.label}
              {active && (
                <span
                  class="absolute -bottom-1 left-3 right-3 h-0.5 rounded-full bg-ctp-mauve animate-fade-in"
                  aria-hidden="true"
                />
              )}
            </a>
          );
        })
      }
    </nav>

    <!-- Right Controls: GitHub Repo, Theme Switcher & Mobile Menu Trigger -->
    <div class="flex items-center gap-2">
      <a
        href={REPO_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Repositório no GitHub (BanguDevClub/atlaseleitoral)"
        title="Código-fonte no GitHub"
        class="group relative flex size-9 items-center justify-center rounded-xl border border-border/70 bg-card text-foreground transition-all duration-200 hover:border-ctp-mauve/50 hover:bg-muted/80 hover:scale-105 active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <svg viewBox="0 0 24 24" class="size-4 fill-current" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
      </a>

      <ThemeSwitcher client:load />

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        id="mobile-menu-btn"
        aria-label="Abrir menu de navegação"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="inline-flex size-9 items-center justify-center rounded-xl border border-border/70 bg-card text-foreground md:hidden transition-colors hover:bg-muted/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring active:scale-95"
      >
        <svg id="hamburger-icon" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
        <svg id="close-icon" class="hidden size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Navigation -->
  <div
    id="mobile-nav"
    class="hidden border-b border-border/70 bg-background/98 backdrop-blur-2xl md:hidden shadow-2xl transition-all duration-300"
    role="region"
    aria-label="Menu móvel"
  >
    <div class="space-y-1.5 px-4 pt-3 pb-5 sm:px-6">
      <div class="flex items-center justify-between pb-2 mb-2 border-b border-border/50 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
        <span>Navegação</span>
        <span class="flex items-center gap-1.5 text-ctp-mauve">
          <span class="size-1.5 rounded-full bg-ctp-green animate-pulse"></span>
          Eleições 2026
        </span>
      </div>

      {
        links.map((link) => {
          const cleanLink = link.href.replace(/\/$/, '');
          const active =
            link.raw === '/'
              ? currentPath === homePath || currentPath === `${homePath}/` || currentPath === '/'
              : currentPath.startsWith(cleanLink);
          return (
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'mobile-nav-link flex min-h-[44px] items-center justify-between rounded-xl px-3.5 text-sm font-medium transition-all active:scale-[0.98]',
                active
                  ? 'bg-muted text-foreground font-semibold shadow-xs border border-border/60'
                  : 'text-muted-foreground hover:bg-muted/60 hover:text-foreground',
              ]}
            >
              <span>{link.label}</span>
              {active ? (
                <span class="size-2 rounded-full bg-ctp-mauve" />
              ) : (
                <span class="text-xs text-muted-foreground/60">→</span>
              )}
            </a>
          );
        })
      }

      <div class="pt-2 mt-2 border-t border-border/50 space-y-1.5">
        <a
          href={REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-nav-link flex min-h-[44px] items-center justify-between rounded-xl px-3.5 text-sm font-medium text-muted-foreground hover:bg-muted/60 hover:text-foreground transition-all"
        >
          <span class="flex items-center gap-2.5">
            <svg viewBox="0 0 24 24" class="size-4 fill-current" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
            </svg>
            <span>Código aberto no GitHub</span>
          </span>
          <span class="text-xs text-muted-foreground/70">↗</span>
        </a>

        <p class="text-center text-[11px] text-muted-foreground/70 pt-2 pb-1">
          Observatório independente · Fontes do TSE e apuração primária
        </p>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('mobile-menu-btn');
    const nav = document.getElementById('mobile-nav');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (!btn || !nav) return;

    function toggleMenu(show) {
      const isExpanded = typeof show === 'boolean' ? !show : btn.getAttribute('aria-expanded') === 'true';
      const willExpand = !isExpanded;
      btn.setAttribute('aria-expanded', String(willExpand));
      nav.classList.toggle('hidden', !willExpand);
      if (hamburgerIcon && closeIcon) {
        hamburgerIcon.classList.toggle('hidden', willExpand);
        closeIcon.classList.toggle('hidden', !willExpand);
      }
    }

    btn.addEventListener('click', () => toggleMenu());

    // Close on navigation click
    nav.querySelectorAll('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', () => {
        toggleMenu(false);
      });
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        toggleMenu(false);
      }
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (btn.getAttribute('aria-expanded') === 'true' && !nav.contains(e.target) && !btn.contains(e.target)) {
        toggleMenu(false);
      }
    });
  })();
</script>
