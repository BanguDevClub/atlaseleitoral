---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import PollsPanel from '@/components/PollsPanel';
import SourceChip from '@/components/SourceChip';
import { Alert, AlertDescription, AlertTitle } from '@/components/ui/alert';
import { candidates, pollsFile } from '@/lib/candidates';
import { formatDate } from '@/lib/format';

const people = Object.fromEntries(
  candidates.map((c) => [c.id, { name: c.ballotName, economic: c.compass.economic }]),
);

const polls = pollsFile?.polls ?? [];
const trendSummary = pollsFile?.trendSummary ?? '';
const sources = pollsFile?.sources ?? [];
---

<BaseLayout
  title="Pesquisas | Atlas Eleitoral"
  description="Intenção de voto nas eleições presidenciais de 2026: últimos levantamentos, cenários de segundo turno e fontes."
>
  <main class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <div class="mb-8">
      <SectionHeading
        eyebrow="Pesquisas"
        title="Intenção de voto"
        description={pollsFile ? `Levantamentos publicados até ${formatDate(pollsFile.asOf)}.` : 'Levantamentos recentes.'}
      />
    </div>

    {
      polls.length > 0 ? (
        <div class="rounded-xl border border-border bg-card p-4 sm:p-6">
          <PollsPanel client:load polls={polls} people={people} />
        </div>
      ) : (
        <Alert>
          <AlertTitle>Pesquisas em atualização</AlertTitle>
          <AlertDescription>Os dados mais recentes de intenção de voto serão exibidos aqui.</AlertDescription>
        </Alert>
      )
    }

    {
      trendSummary && (
        <section class="mt-10 flex flex-col gap-3">
          <h2 class="font-heading text-xl font-semibold">Leitura da disputa</h2>
          {trendSummary.split('\n\n').map((paragraph) => (
            <p class="text-sm leading-relaxed text-muted-foreground">{paragraph}</p>
          ))}
        </section>
      )
    }

    {
      sources.length > 0 && (
        <section class="mt-8 flex flex-col gap-3">
          <h2 class="font-heading text-xl font-semibold">Fontes</h2>
          <div class="flex flex-wrap gap-2">
            {sources.map((source) => (
              <SourceChip source={source} />
            ))}
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>
