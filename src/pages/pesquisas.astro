---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import PollsPanel from '@/components/PollsPanel';
import SourceChip from '@/components/SourceChip';
import { Alert, AlertDescription, AlertTitle } from '@/components/ui/alert';
import { candidates, pollsFile } from '@/lib/candidates';
import { formatDate } from '@/lib/format';

const people = Object.fromEntries(
  candidates.map((c) => [c.id, { name: c.ballotName, economic: c.compass.economic }]),
);

const polls = pollsFile?.polls ?? [];
const trendSummary = pollsFile?.trendSummary ?? '';
const sources = pollsFile?.sources ?? [];
---

<BaseLayout
  title="Pesquisas Eleitorais 2026 — Intenção de Voto Consolidada | Atlas Eleitoral"
  description="Agregador e histórico de pesquisas de intenção de voto para a Presidência do Brasil em 2026. Cenários de 1º e 2º turno, dados amostrais, institutos e fontes oficiais do TSE."
  keywords="pesquisas eleitorais 2026, intenção de voto brasil 2026, pesquisa presidência 2026, datafolha 2026, quaest 2026, atlasintel 2026, paraná pesquisas, tse pesquisas registradas"
  image="/og-image.jpg"
>
  <main class="mx-auto max-w-5xl px-4 py-8 sm:py-12 sm:px-6">
    <div class="mb-8">
      <SectionHeading
        eyebrow="Dados Consolidados"
        title="Pesquisas de intenção de voto"
        description={pollsFile ? `Levantamentos públicos registrados até ${formatDate(pollsFile.asOf)}.` : 'Levantamentos recentes registrados no TSE.'}
      />
    </div>

    {
      polls.length > 0 ? (
        <div class="glass-panel rounded-2xl p-5 sm:p-8">
          <PollsPanel client:load polls={polls} people={people} />
        </div>
      ) : (
        <Alert>
          <AlertTitle>Pesquisas em atualização</AlertTitle>
          <AlertDescription>Os dados mais recentes de intenção de voto serão exibidos aqui assim que homologados.</AlertDescription>
        </Alert>
      )
    }

    {
      trendSummary && (
        <section class="mt-10 glass-panel rounded-2xl p-6 sm:p-8 space-y-4">
          <h2 class="font-heading text-lg font-bold text-foreground flex items-center gap-2">
            <span class="size-2 rounded-full bg-ctp-mauve"></span>
            Análise do Cenário Eleitoral
          </h2>
          <div class="space-y-3">
            {trendSummary.split('\n\n').map((paragraph) => (
              <p class="text-sm leading-relaxed text-muted-foreground">{paragraph}</p>
            ))}
          </div>
        </section>
      )
    }

    {
      sources.length > 0 && (
        <section class="mt-8 flex flex-col gap-3">
          <h2 class="font-heading text-sm font-bold uppercase tracking-wider text-muted-foreground">Institutos e Fontes Registradas</h2>
          <div class="flex flex-wrap gap-2">
            {sources.map((source) => (
              <SourceChip source={source} />
            ))}
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>
