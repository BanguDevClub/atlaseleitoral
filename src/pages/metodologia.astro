---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import SourceChip from '@/components/SourceChip';
import { Badge } from '@/components/ui/badge';
import { Separator } from '@/components/ui/separator';
import { electionFacts } from '@/lib/candidates';
import { ORIENTATION_COLOR } from '@/components/OrientationBadge';

const sections = [
  {
    id: 'fontes',
    title: 'Fontes e citação primária',
    body: [
      'Toda afirmação de fato exibida no Atlas exibe a fonte original em um selo clicável: meio, data e link direto. Priorizamos fontes oficiais primárias (TSE, Congresso Nacional, Câmara dos Deputados, Senado Federal, diários oficiais e programas de governo registrados) combinadas com a cobertura apurada pelos principais veículos jornalísticos de referência.',
      'Citações e declarações são transcritas com data exata e o contexto factual em que foram proferidas. Quando não foi possível verificar uma informação em fonte confiável e pública, ela não é incluída.',
    ],
  },
  {
    id: 'eixos',
    title: 'Os dois eixos do compasso político',
    body: [
      'Eixo econômico (horizontal): graduado de −10 (intervenção estatal ampla, fortalecimento de estatais, regulação e tributação progressiva) a +10 (livre-mercado, privatização, desregulamentação e austeridade fiscal estrita).',
      'Eixo social (vertical): graduado de −10 (conservador: ordem, segurança institucional e valores tradicionais) a +10 (progressista: liberdades individuais, garantias fundamentais e pautas sociais inclusivas).',
      'As coordenadas representam sínteses editoriais construídas a partir de evidências sólidas: primeiro o registro documental (votos, programa, declarações), depois a atribuição da coordenada que melhor sintetiza o conjunto. Cada ficha detalha as evidências consideradas.',
    ],
  },
  {
    id: 'confianca',
    title: 'Grau de confiança da classificação',
    body: [
      'Alta: histórico extenso e consistente em mandatos prévios, votações no parlamento e programa oficial consolidado. Média: evidências sólidas com registros públicos consistentes, mas com menor histórico legislativo ou contradições pontuais. Baixa: poucas fontes primárias disponíveis até o momento — classificação preliminar sujeita a constante revisão.',
    ],
  },
  {
    id: 'cores',
    title: 'Sistema de cores e temas visuais',
    body: [
      'A identidade cromática de cada candidato reflete seu posicionamento no eixo econômico: tons avermelhados (esquerda) → roxo/violeta (centro) → azulados (direita). O eixo social é percebido pela posição espacial no mapa.',
      'O design conta com suporte integral aos modos Claro e Escuro, construído sobre as variantes da paleta de alta harmonia Catppuccin — Latte (tema claro), Frappé, Macchiato e Mocha (temas escuros) — alternáveis pelo menu superior.',
    ],
  },
  {
    id: 'controversias',
    title: 'Documentação de controvérsias e processos',
    body: [
      'São catalogados exclusivamente casos de repercussão pública documentados por fontes jornalísticas reconhecidas e registros jurídicos oficiais, informando sempre o status atualizado (inquérito arquivado, processo em andamento, absolvição ou condenação com recurso pendente).',
      'A redação prioriza a estrita descrição factual, sem termos adjetivos ou juízo de culpa. A ausência de registro em uma ficha indica apenas inexistência de documentação qualificada nos critérios deste projeto.',
    ],
  },
  {
    id: 'limites',
    title: 'Independência e limites deste atlas',
    body: [
      'O Atlas Eleitoral é uma iniciativa de utilidade pública e educação cívica, sem vínculos partidários ou financiamento de candidaturas. Erros e complementações factuais são corrigidos continuamente com novas evidências.',
      'Pesquisas de intenção de voto representam retratos amostrais momentâneos da opinião pública e possuem margens estatísticas de erro; não constituem previsão antecipada de resultados nas urnas.',
    ],
  },
];
---

<BaseLayout
  title="Metodologia Editorial e Critérios de Apuração | Atlas Eleitoral"
  description="Conheça os critérios técnicos, catalogação de fontes primárias do TSE e fundamentação do modelo bidimensional do compasso político brasileiro."
  keywords="metodologia eleitoral, fontes primárias tse, critérios compasso político, apuração checagem fatos eleições brasil, transparência política, dados públicos brasil"
  image="/og-image.jpg"
>
  <main class="mx-auto max-w-4xl px-4 py-8 sm:py-12 sm:px-6">
    <div class="mb-8">
      <SectionHeading
        eyebrow="Transparência e Rigor"
        title="Metodologia Editorial e Apuração"
        description="Conheça os critérios técnicos, éticos e documentais aplicados na classificação de candidaturas, agregação de pesquisas e fontes."
      />
    </div>

    <div class="flex flex-col gap-6">
      {
        sections.map((section) => (
          <div id={section.id} class="glass-panel rounded-2xl p-6 sm:p-8 space-y-4">
            <h3 class="font-heading text-lg font-bold text-foreground flex items-center gap-2.5">
              <span class="size-2 rounded-full bg-ctp-mauve"></span>
              {section.title}
            </h3>
            <div class="space-y-3">
              {section.body.map((paragraph) => (
                <p class="text-sm leading-relaxed text-muted-foreground">{paragraph}</p>
              ))}
            </div>
          </div>
        ))
      }

      <div class="glass-panel rounded-2xl p-6 sm:p-8 space-y-4">
        <div>
          <h3 class="font-heading text-lg font-bold text-foreground">Classificação de orientação por tema</h3>
          <p class="text-xs text-muted-foreground mt-1">Rótulos sintéticos utilizados nas fichas e comparações temáticas</p>
        </div>
        <div class="flex flex-wrap gap-2 pt-2">
          {(['esquerda', 'centro-esquerda', 'centro', 'centro-direita', 'direita'] as const).map((orientation) => (
            <span
              class="inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold uppercase tracking-wider"
              style={`color:${ORIENTATION_COLOR[orientation]};border-color:color-mix(in oklch, ${ORIENTATION_COLOR[orientation]} 45%, transparent);background:color-mix(in oklch, ${ORIENTATION_COLOR[orientation]} 12%, transparent)`}
            >
              {orientation}
            </span>
          ))}
        </div>
      </div>
    </div>

    <Separator className="my-10" />

    <section class="flex flex-col gap-4">
      <h2 class="font-heading text-xl font-bold text-foreground">Bases de Dados e Fontes Primárias</h2>
      <div class="flex flex-wrap gap-2">
        <Badge variant="outline" className="font-semibold">TSE — DivulgaCandContas</Badge>
        <Badge variant="outline" className="font-semibold">Programas de Governo Oficiais</Badge>
        <Badge variant="outline" className="font-semibold">Diário Oficial da União</Badge>
        {
          electionFacts?.sources.map((source) => (
            <SourceChip source={source} />
          ))
        }
      </div>

      <div class="mt-4 glass-panel rounded-2xl p-6 border-l-4 border-l-ctp-teal">
        <h3 class="font-heading text-sm font-bold text-foreground">Compromisso com a Imparcialidade</h3>
        <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
          Nenhuma candidatura é impulsionada ou priorizada visualmente. Listagens padrão seguem ordenações neutras por número de urna, ordem alfabética ou ordenação explícita escolhida pelo usuário.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
