---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import CompareTool, { forComparison } from "@/components/CompareTool";
import { candidates } from "@/lib/candidates";
import { url } from "@/lib/base";

const comparisonCandidates = candidates.map(forComparison);
---

<BaseLayout
  title="Comparar Candidatos Lado a Lado — Eleições Presidenciais 2026 | Atlas Eleitoral"
  description="Compare até 4 candidatos à Presidência do Brasil em 2026 lado a lado: posições oficiais documentadas em 9 áreas temáticas, coordenadas no compasso, histórico, chapa e fontes primárias."
  keywords="comparar candidatos 2026, comparação de propostas brasil, lula vs flavio bolsonaro, zema vs caiado, planos de governo 2026 comparados, eleições presidenciais brasil"
  image="/og-image.jpg"
>
  <main class="mx-auto max-w-7xl px-4 py-8 sm:py-12 sm:px-6">
    <div class="mb-8">
      <SectionHeading
        eyebrow="Painel Comparativo"
        title="Comparação direta entre concorrentes"
        description="Selecione de 2 a 4 candidatos para contrastar posições em 9 áreas temáticas, coordenadas no compasso e histórico público documentado."
      />
    </div>

    <CompareTool client:load candidates={comparisonCandidates} />

    <div
      class="mt-10 glass-panel rounded-2xl p-6 border-l-4 border-l-ctp-mauve"
    >
      <h3 class="font-heading text-sm font-bold text-foreground">
        Como interpretar as posições
      </h3>
      <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
        Cada célula resume a posição documentada em programa de governo oficial
        ou em declarações públicas verificadas. A classificação de orientação
        (esquerda a direita) deriva estritamente da evidência catalogada —
        consulte os detalhes na&nbsp
        <a
          href={url('/metodologia')}
          class="font-medium text-ctp-mauve underline underline-offset-4 hover:text-foreground"
          >metodologia editorial</a
        >.
      </p>
    </div>
  </main>
</BaseLayout>
