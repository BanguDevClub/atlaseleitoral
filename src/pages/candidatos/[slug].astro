---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PhotoAvatar from '@/components/PhotoAvatar.astro';
import SourceChip from '@/components/SourceChip';
import CompassGlyph from '@/components/CompassGlyph';
import OrientationBadge from '@/components/OrientationBadge';
import SectionHeading from '@/components/SectionHeading.astro';
import { Alert, AlertDescription, AlertTitle } from '@/components/ui/alert';
import { Badge } from '@/components/ui/badge';
import LinkButton from "@/components/LinkButton";
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Empty, EmptyDescription, EmptyHeader, EmptyMedia, EmptyTitle } from '@/components/ui/empty';
import { Separator } from '@/components/ui/separator';
import { candidates } from '@/lib/candidates';
import { formatDate, formatScore } from '@/lib/format';
import { candidateColor, quadrantOf } from '@/lib/palette';
import { url } from '@/lib/base';
import type { Candidate } from '@/lib/types';

export function getStaticPaths() {
  return candidates.map((candidate) => ({ params: { slug: candidate.slug }, props: { candidate } }));
}

const { candidate } = Astro.props as { candidate: Candidate };

const initials = candidate.ballotName
  .split(/\s+/)
  .map((word) => word[0])
  .slice(0, 2)
  .join('');

const color = candidateColor(candidate.compass.economic);
const quadrant = quadrantOf(candidate.compass.social, candidate.compass.economic);

const sections = [
  { id: 'perfil', label: 'Perfil' },
  { id: 'posicoes', label: `Posições (${candidate.keyPositions.length})` },
  { id: 'declaracoes', label: `Declarações (${candidate.statements.length})` },
  { id: 'compasso', label: 'Compasso' },
  { id: 'controversias', label: `Controvérsias (${candidate.scandals.length})` },
];
---

<BaseLayout
  title={`${candidate.ballotName} (${candidate.party}) | Atlas Eleitoral`}
  description={`Ficha completa de ${candidate.name}: biografia, posições documentadas por tema, declarações textuais e controvérsias com fontes primárias. Classificação no compasso político.`}
>
  <main class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <!-- Breadcrumb -->
    <div class="mb-6 flex items-center gap-2 text-xs text-muted-foreground">
      <a href={url('/')} class="hover:text-foreground">Início</a>
      <span>/</span>
      <a href={url('/candidatos')} class="hover:text-foreground">Candidatos</a>
      <span>/</span>
      <span class="font-medium text-foreground">{candidate.ballotName}</span>
    </div>

    <!-- Candidate Hero Header -->
    <section class="relative overflow-hidden rounded-2xl border border-border/80 bg-card p-6 shadow-sm transition-all sm:p-8">
      {/* Decorative Spectrum Background Glow */}
      <div
        class="pointer-events-none absolute -right-20 -top-20 size-72 rounded-full opacity-15 blur-3xl"
        style={`background: ${color}`}
        aria-hidden="true"
      />

      <div class="relative flex flex-col gap-6 sm:flex-row sm:items-start">
        <div class="relative shrink-0">
          <PhotoAvatar
            photo={candidate.photo}
            alt={`Foto de ${candidate.name}`}
            initials={initials}
            size={104}
            class="rounded-2xl border-2 shadow-md transition-transform"
          />
          <span
            class="absolute -bottom-2 -right-2 size-5 rounded-full border-2 border-card shadow-xs"
            style={`background: ${color}`}
            title={`Orientação no eixo econômico: ${quadrant.label}`}
          />
        </div>

        <div class="min-w-0 flex-1 space-y-3">
          <div class="flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center rounded-lg bg-foreground px-2.5 py-0.5 font-mono text-xs font-bold text-background tabular-nums">
              nº {candidate.number}
            </span>
            <Badge variant="outline" className="font-semibold border-border/80">
              {candidate.party} — {candidate.partyFullName}
            </Badge>
            <Badge variant="secondary">{candidate.status}</Badge>
            {candidate.coalition && <Badge variant="secondary">{candidate.coalition}</Badge>}
          </div>

          <div>
            <h1 class="font-heading text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
              {candidate.ballotName}
            </h1>
            <p class="mt-1 text-sm font-medium text-muted-foreground">
              {candidate.name} · {candidate.age} anos · {candidate.occupation}
            </p>
          </div>

          <p class="max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">
            {candidate.headline}
          </p>

          <div class="flex flex-wrap items-center gap-2 pt-1 text-xs text-muted-foreground">
            <span>Candidato(a) a Vice:</span>
            <strong class="text-foreground">{candidate.vice.name}</strong>
            <span class="rounded bg-muted px-1.5 py-0.5 font-mono">{candidate.vice.party}</span>
          </div>
        </div>

        <!-- Compass Glyph & Scores Box -->
        <div class="flex shrink-0 items-center gap-4 rounded-xl border border-border/70 bg-muted/40 p-4 backdrop-blur-xs">
          <CompassGlyph social={candidate.compass.social} economic={candidate.compass.economic} size={90} />
          <div class="flex flex-col gap-1.5 text-xs">
            <span class="font-bold text-sm" style={`color:${color}`}>{quadrant.label}</span>
            <div class="flex flex-col font-mono text-xs text-muted-foreground">
              <span>Social: <strong class="text-foreground">{formatScore(candidate.compass.social)}</strong></span>
              <span>Econômico: <strong class="text-foreground">{formatScore(candidate.compass.economic)}</strong></span>
            </div>
            <span class="text-[11px] text-muted-foreground">
              Confiança: <span class="capitalize font-medium text-foreground">{candidate.compass.confidence}</span>
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Sticky Jump Navigation -->
    <nav
      aria-label="Seções da ficha"
      class="sticky top-16 z-30 my-6 flex flex-wrap gap-2 rounded-xl border border-border/60 bg-background/90 p-2 backdrop-blur-md shadow-xs transition-colors"
    >
      {
        sections.map((section) => (
          <a
            href={`#${section.id}`}
            class="inline-flex h-8 items-center rounded-lg border border-border/60 bg-card px-3.5 text-xs font-semibold text-muted-foreground transition-all duration-200 hover:border-ctp-mauve/50 hover:bg-muted hover:text-foreground"
          >
            {section.label}
          </a>
        ))
      }
    </nav>

    <!-- Perfil -->
    <section id="perfil" class="scroll-mt-28 flex flex-col gap-4">
      <SectionHeading eyebrow="Trajetória" title="Quem é o candidato" />
      <div class="glass-panel rounded-2xl p-6 sm:p-8 space-y-4">
        {candidate.bio.map((paragraph) => <p class="leading-relaxed text-muted-foreground text-sm sm:text-base">{paragraph}</p>)}
        <p class="leading-relaxed text-muted-foreground text-sm sm:text-base border-t border-border/50 pt-4">
          <strong class="text-foreground font-semibold">Histórico Político:</strong> {candidate.politicalJourney}
        </p>
        <div class="flex flex-wrap gap-2 pt-2 text-xs">
          <Badge variant="secondary">
            Nascimento: {candidate.birth.city}/{candidate.birth.state}, {candidate.birth.year}
          </Badge>
          <Badge variant="secondary">Profissão: {candidate.occupation}</Badge>
          <Badge variant="secondary">Registro TSE: {candidate.status}</Badge>
        </div>
      </div>
    </section>

    <Separator className="my-10" />

    <!-- Posições por tema -->
    <section id="posicoes" class="scroll-mt-28 flex flex-col gap-4">
      <SectionHeading
        eyebrow="Programa e Votos"
        title="Posições documentadas por tema"
        description="Síntese do posicionamento oficial com base em programas registrados no TSE, votações nominais e declarações públicas."
      />
      <div class="grid gap-4 sm:grid-cols-2">
        {
          candidate.keyPositions.map((position) => (
            <Card className="interactive-card rounded-2xl border border-border/70 bg-card p-5 transition-all">
              <CardHeader className="p-0 pb-3 space-y-2">
                <CardTitle className="text-base font-bold text-foreground">{position.topic}</CardTitle>
                <div>
                  <OrientationBadge orientation={position.orientation} />
                </div>
              </CardHeader>
              <CardContent className="p-0 flex flex-col gap-3">
                <p class="text-sm leading-relaxed text-muted-foreground">{position.stance}</p>
                <div class="flex flex-wrap gap-1.5 pt-2 border-t border-border/50">
                  {position.sources.map((source) => (
                    <SourceChip source={source} />
                  ))}
                </div>
              </CardContent>
            </Card>
          ))
        }
      </div>
    </section>

    <Separator className="my-10" />

    <!-- Declarações -->
    <section id="declaracoes" class="scroll-mt-28 flex flex-col gap-4">
      <SectionHeading
        eyebrow="No Registro Público"
        title="Declarações e falas públicas"
        description="Frases com transcrição literal, data, contexto e link para a cobertura original."
      />
      <div class="flex flex-col gap-4">
        {
          candidate.statements.map((statement) => (
            <div class="relative overflow-hidden rounded-2xl border border-border/70 bg-card p-6 shadow-xs transition-all hover:border-ctp-mauve/40">
              <span class="pointer-events-none absolute right-4 top-2 select-none font-serif text-6xl text-muted/30">
                “
              </span>
              <div class="relative flex flex-col gap-3">
                <blockquote class="border-l-3 border-ctp-mauve pl-4 font-heading text-lg font-medium leading-relaxed italic text-foreground text-balance">
                  “{statement.quote}”
                </blockquote>
                <div class="flex flex-col gap-2 pt-2 border-t border-border/50 text-xs text-muted-foreground">
                  <p class="leading-relaxed">{statement.context}</p>
                  <div class="flex flex-wrap items-center gap-2 pt-1">
                    <Badge variant="outline" className="font-mono tabular-nums">
                      {formatDate(statement.date)}
                    </Badge>
                    <SourceChip source={statement.source} />
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <Separator className="my-10" />

    <!-- Compasso -->
    <section id="compasso" class="scroll-mt-28 flex flex-col gap-4">
      <SectionHeading
        eyebrow="Posicionamento no Atlas"
        title="Justificativa da classificação"
        description="Por que este candidato está nestas coordenadas — fundamentação e evidências."
      />
      <div class="grid gap-6 sm:grid-cols-[auto_1fr] sm:items-start glass-panel rounded-2xl p-6 sm:p-8">
        <div class="flex flex-col items-center gap-3 rounded-xl border border-border/70 bg-card p-4 shadow-xs">
          <CompassGlyph social={candidate.compass.social} economic={candidate.compass.economic} size={140} />
          <div class="flex flex-col items-center gap-1 text-center text-xs">
            <span style={`color:${color}`} class="font-bold text-sm">{quadrant.label}</span>
            <span class="font-mono text-muted-foreground">Social: {formatScore(candidate.compass.social)} / 10</span>
            <span class="font-mono text-muted-foreground">Econômico: {formatScore(candidate.compass.economic)} / 10</span>
            <Badge variant="outline" className="mt-1">Grau de confiança: {candidate.compass.confidence}</Badge>
          </div>
        </div>
        <div class="flex flex-col gap-4">
          <h3 class="font-heading text-lg font-bold text-foreground">Fundamentação Editorial</h3>
          <p class="leading-relaxed text-muted-foreground text-sm sm:text-base">{candidate.compass.rationale}</p>
          <div class="flex flex-wrap gap-1.5 pt-2 border-t border-border/50">
            {candidate.compass.sources.map((source) => (
              <SourceChip source={source} />
            ))}
          </div>
          <div>
            <LinkButton href="/compasso" variant="outline" size="sm" className="w-fit">
              Ver mapa completo do compasso →
            </LinkButton>
          </div>
        </div>
      </div>
    </section>

    <Separator className="my-10" />

    <!-- Controvérsias -->
    <section id="controversias" class="scroll-mt-28 flex flex-col gap-4">
      <SectionHeading
        eyebrow="Fiscalização Cívica"
        title="Controvérsias documentadas"
        description="Casos investigados ou repercutidos com status judicial e fontes verificáveis. Sem juízo de valor."
      />
      {
        candidate.scandals.length > 0 ? (
          <div class="flex flex-col gap-4">
            {candidate.scandals.map((scandal) => (
              <Card className="rounded-2xl border border-border/70 bg-card p-5">
                <CardHeader className="p-0 pb-3 space-y-2">
                  <div class="flex flex-wrap items-start justify-between gap-2">
                    <CardTitle className="text-base font-bold text-foreground">{scandal.title}</CardTitle>
                    <div class="flex flex-wrap gap-2">
                      <Badge variant="secondary" className="font-mono tabular-nums text-xs">
                        {scandal.period}
                      </Badge>
                      <Badge variant="outline" className="font-semibold text-xs border-ctp-mauve/40 text-ctp-mauve">
                        {scandal.status}
                      </Badge>
                    </div>
                  </div>
                </CardHeader>
                <CardContent className="p-0 flex flex-col gap-3">
                  <p class="text-sm leading-relaxed text-muted-foreground">{scandal.summary}</p>
                  <div class="flex flex-wrap gap-1.5 pt-2 border-t border-border/50">
                    {scandal.sources.map((source) => (
                      <SourceChip source={source} />
                    ))}
                  </div>
                </CardContent>
              </Card>
            ))}
          </div>
        ) : (
          <Empty className="glass-panel rounded-2xl py-10 border border-dashed border-border/80">
            <EmptyHeader>
              <EmptyMedia variant="icon">
                <svg viewBox="0 0 24 24" class="size-6 text-ctp-green" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10" />
                  <path d="m9 12 2 2 4-4" />
                </svg>
              </EmptyMedia>
              <EmptyTitle>Nenhuma controvérsia de grande repercussão documentada</EmptyTitle>
              <EmptyDescription>
                Não localizamos inquéritos, processos ou controvérsias de ampla notoriedade pública com cobertura verificável para esta candidatura.
              </EmptyDescription>
            </EmptyHeader>
          </Empty>
        )
      }
    </section>

    <!-- Bottom Actions -->
    <div class="mt-12 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-border/70 bg-card p-6">
      <div>
        <h4 class="font-heading text-base font-bold text-foreground">Deseja comparar propostas?</h4>
        <p class="text-xs text-muted-foreground">Compare {candidate.ballotName} lado a lado com qualquer outro concorrente.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <LinkButton href="/comparar" variant="outline" size="sm">
          Comparar candidatos
        </LinkButton>
        <LinkButton href="/candidatos" variant="ghost" size="sm">
          Ver todos os candidatos →
        </LinkButton>
      </div>
    </div>
  </main>
</BaseLayout>
