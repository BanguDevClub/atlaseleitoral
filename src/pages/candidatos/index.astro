---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CandidateExplorer from '@/components/CandidateExplorer';
import { candidates } from '@/lib/candidates';
---

<BaseLayout
  title="Candidatos à Presidência 2026 | Atlas Eleitoral"
  description="Fichas completas e verificadas de todos os candidatos à Presidência do Brasil em 2026: biografia, posições por tema, declarações e controvérsias com fontes primárias."
>
  <main class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <div class="mb-8">
      <SectionHeading
        eyebrow="Eleições Presidenciais 2026"
        title="Candidatos à Presidência da República"
        description="Filtre por partido ou espectro ideológico, busque por temas específicos e ordene pelo número de urna ou posicionamento no compasso político."
      />
    </div>
    <CandidateExplorer client:load candidates={candidates} />
  </main>
</BaseLayout>
