---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CandidateExplorer from '@/components/CandidateExplorer';
import { candidates } from '@/lib/candidates';
---

<BaseLayout
  title="Candidatos à Presidência 2026 — Fichas, Propostas e Compasso | Atlas Eleitoral"
  description="Explore as 13 candidaturas à Presidência do Brasil em 2026. Fichas detalhadas, posições documentadas por tema, declarações textuais e classificação no compasso político com fontes primárias."
  keywords="candidatos presidência 2026, eleições 2026 brasil, propostas candidatos brasil, lula, flavio bolsonaro, zema, ronaldo caiado, renan santos, partidos brasil, compasso político candidatos"
  image="/og-image.jpg"
>
  <main class="mx-auto max-w-7xl px-4 py-8 sm:py-12 sm:px-6">
    <div class="mb-8">
      <SectionHeading
        eyebrow="Eleições Presidenciais 2026"
        title="Candidatos à Presidência da República"
        description="Filtre por partido ou espectro ideológico, busque por temas específicos e ordene pelo número de urna ou posicionamento no compasso político."
      />
    </div>
    <CandidateExplorer client:load candidates={candidates} />
  </main>
</BaseLayout>
